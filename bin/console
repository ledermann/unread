#!/usr/bin/env ruby

# Start IRB with the spec models on a fresh database (default: SQLite in memory)
require 'bundler/setup'
require 'erb'
require 'irb'
require 'unread'

$LOAD_PATH.unshift(File.expand_path('../spec', __dir__))
require 'app/models'
require 'support/database'

Database.setup
ActiveRecord::Base.logger = Logger.new($stdout)

IRB.start(__FILE__)
